# originally scavenged from https://github.com/facebookresearch/vissl/
# updated with tips from https://www.reddit.com/r/Python/comments/40s8qw/simplify_your_manifestin_commands/
global-exclude __pycache__

# yeeeeesh
# pip uninstall -y pyttitools-core; rm -r pytti-core/build; rm -r pytti-core/src/pyttitools_core.egg-info

# Include config files and presets
graft src/pytti/config

# Include assets
graft src/pytti/assets

# Include documentation
include README.md
include QUICK_START.md
include WEBUI_GUIDE.md
include MODERNIZATION_README.md
include MODERNIZATION_COMPLETE.md
include MODERN_USAGE_EXAMPLES.md
include LICENSE

# Include requirements files
include requirements.txt
include requirements-modern.txt
include requirements-webui.txt

# Include utility scripts
include validate_installation.py
include migrate_config.py

# Exclude unnecessary files
global-exclude *.pyc
global-exclude *.pyo
global-exclude *~
global-exclude __pycache__
global-exclude .git*
global-exclude .DS_Store
